{{- /* 검색 인덱스 — 목록 레이아웃을 쓰는 모든 섹션의 글을 담는다.
       "section" 필드로 섹션을 구분하고, 검색 UI가 자기 섹션만 필터링한다. */ -}}
{{- $out := slice -}}
{{- range where site.RegularPages "Type" "in" (slice "blog" "dev") -}}
{{- $cat := "" -}}{{- with .Parent }}{{ $cat = .Title }}{{ end -}}
{{- $out = $out | append (dict
      "title" .Title
      "url" .RelPermalink
      "section" .Section
      "date" (.Date.Format "2006-01-02")
      "category" $cat
      "tags" (.Params.tags | default slice)
      "desc" (.Description | default "")
      "content" .Plain) -}}
{{- end -}}
{{- $out | jsonify -}}

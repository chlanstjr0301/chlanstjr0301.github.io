# 블로그용 matplotlib 스타일 — Munseok's Log 색과 맞춘 정적 차트(SVG/PNG)
# 사용: import matplotlib.pyplot as plt; plt.style.use("tools/blog.mplstyle")
#       plt.savefig("fig.svg", transparent=True)  ← 투명 배경이라 라이트/다크 둘 다 자연스럽다
# Pretendard가 PC에 설치돼 있어야 한글이 같은 글꼴로 나온다 (없으면 맑은 고딕으로 대체).

font.family: Pretendard, Malgun Gothic, AppleGothic, sans-serif
font.size: 13
axes.unicode_minus: False

figure.figsize: 8.6, 4.4
figure.dpi: 150
savefig.bbox: tight
savefig.transparent: True

# 축: 왼쪽·아래만, 가는 회색 선
axes.spines.top: False
axes.spines.right: False
axes.edgecolor: 8a909a
axes.linewidth: 0.8
axes.labelcolor: 8a909a
axes.titlesize: 15
axes.titleweight: 600
axes.titlelocation: left
axes.titlepad: 14
xtick.color: 8a909a
ytick.color: 8a909a
xtick.major.size: 0
ytick.major.size: 0

# 가로 격자선만 옅게
axes.grid: True
axes.grid.axis: y
grid.color: 8a909a
grid.alpha: 0.25
grid.linewidth: 0.8

# 색: 강조 파랑 + 회색 단계 (색 3계열 이내)
axes.prop_cycle: cycler('color', ['2a64cc', '8a909a', '7aa7ff', 'c5c9d0'])
lines.linewidth: 2
legend.frameon: False
legend.fontsize: 12
